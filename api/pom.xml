<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.osgi</groupId>
		<artifactId>osgi.core.reactor</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>osgi.core</artifactId>
	<name>OSGi Core</name>

	<properties>
		<api.sources>${project.build.directory}/sources</api.sources>
	</properties>

	<!-- The jar carries the classes of the API artifacts listed below, unchanged.
	     They are unpacked, not declared as dependencies: the published pom of
	     osgi.core has osgi.annotation as its only dependency. -->
	<dependencies>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>osgi.annotation</artifactId>
			<version>${osgi.annotation.version}</version>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<!-- no sources of its own: sources-jar packages the
					     unpacked sources instead -->
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<configuration>
						<skipSource>true</skipSource>
					</configuration>
				</plugin>
				<plugin>
					<!-- as the javadoc of osgi.core in the monorepo
					     (cnf/gradle/companion.gradle) -->
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<configuration>
						<sourcepath>${api.sources}</sourcepath>
						<doctitle>OSGi&amp;reg; Core Release ${parsedVersion.majorVersion}</doctitle>
						<windowtitle>OSGi Core Release ${parsedVersion.majorVersion}</windowtitle>
						<header>&lt;b&gt;OSGi&amp;reg; Core&lt;/b&gt;&lt;br/&gt;Release ${parsedVersion.majorVersion}</header>
						<bottom>Copyright &amp;copy; Contributors to the Eclipse Foundation Licensed under the &lt;a href="https://www.eclipse.org/legal/efsl.php" target="_blank"&gt;Eclipse Foundation Specification License – v1.0&lt;/a&gt;</bottom>
						<show>protected</show>
						<author>false</author>
						<version>false</version>
						<use>true</use>
						<splitindex>true</splitindex>
						<notimestamp>true</notimestamp>
						<!-- the Log Service API refers to the Log Stream Provider of
						     the Compendium: on the class path, not documented here -->
						<additionalDependencies>
							<additionalDependency>
								<groupId>org.osgi</groupId>
								<artifactId>org.osgi.service.log.stream</artifactId>
								<version>${org.osgi.service.log.stream.version}</version>
							</additionalDependency>
						</additionalDependencies>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<id>unpack-api</id>
						<phase>process-classes</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}</outputDirectory>
							<includes>org/**</includes>
							<artifactItems>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.dto</artifactId>
									<version>${org.osgi.dto.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.framework</artifactId>
									<version>${org.osgi.framework.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.resource</artifactId>
									<version>${org.osgi.resource.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.condition</artifactId>
									<version>${org.osgi.service.condition.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.condpermadmin</artifactId>
									<version>${org.osgi.service.condpermadmin.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.log</artifactId>
									<version>${org.osgi.service.log.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.packageadmin</artifactId>
									<version>${org.osgi.service.packageadmin.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.permissionadmin</artifactId>
									<version>${org.osgi.service.permissionadmin.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.resolver</artifactId>
									<version>${org.osgi.service.resolver.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.startlevel</artifactId>
									<version>${org.osgi.service.startlevel.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.url</artifactId>
									<version>${org.osgi.service.url.version}</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.util.tracker</artifactId>
									<version>${org.osgi.util.tracker.version}</version>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
					<execution>
						<!-- the sources of the same artifacts, for the sources
						     and javadoc jars; they are not compiled -->
						<id>unpack-api-sources</id>
						<phase>process-classes</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<outputDirectory>${api.sources}</outputDirectory>
							<includes>org/**</includes>
							<artifactItems>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.dto</artifactId>
									<version>${org.osgi.dto.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.framework</artifactId>
									<version>${org.osgi.framework.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.resource</artifactId>
									<version>${org.osgi.resource.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.condition</artifactId>
									<version>${org.osgi.service.condition.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.condpermadmin</artifactId>
									<version>${org.osgi.service.condpermadmin.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.log</artifactId>
									<version>${org.osgi.service.log.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.packageadmin</artifactId>
									<version>${org.osgi.service.packageadmin.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.permissionadmin</artifactId>
									<version>${org.osgi.service.permissionadmin.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.resolver</artifactId>
									<version>${org.osgi.service.resolver.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.startlevel</artifactId>
									<version>${org.osgi.service.startlevel.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.service.url</artifactId>
									<version>${org.osgi.service.url.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
								<artifactItem>
									<groupId>org.osgi</groupId>
									<artifactId>org.osgi.util.tracker</artifactId>
									<version>${org.osgi.util.tracker.version}</version>
									<classifier>sources</classifier>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.plugin.version}</version>
				<executions>
					<execution>
						<id>sources-jar</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>sources</classifier>
							<classesDirectory>${api.sources}</classesDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>biz.aQute.bnd</groupId>
				<artifactId>bnd-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>biz.aQute.bnd</groupId>
				<artifactId>bnd-baseline-maven-plugin</artifactId>
				<configuration>
					<!-- against the last release of osgi.core, which this
					     version rebuilds -->
					<base>
						<version>[8.0.0]</version>
					</base>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
