<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.osgi</groupId>
	<artifactId>osgi.core.reactor</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>
	<description>OSGi Core Release</description>

	<!-- The version lives in exactly one place: .mvn/maven.config
	     (-Drevision=...). Maven picks that file up from the repo root for
	     every build, and the release workflow matches the git tag against
	     it. No revision property here — a second copy would just drift. -->
	<parent>
		<groupId>org.osgi</groupId>
		<artifactId>org.osgi.maven.pom.parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!-- The SNAPSHOT parent is deployed to Central snapshots, not Maven
	     Central. The repositories declared in the parent cannot help to
	     resolve the parent itself, but repositories declared here in the
	     child are used for parent resolution — without this block a fresh
	     clone cannot build. Remove once the parent is a Central release. -->
	<repositories>
		<repository>
			<id>central-snapshots</id>
			<name>Central Snapshots</name>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<!-- Plugin and build-extension dependencies (e.g. the tck-bnd-plugins
	     jar on the bnd-maven-plugin classpath) resolve via
	     pluginRepositories, not repositories — same snapshot store. -->
	<pluginRepositories>
		<pluginRepository>
			<id>central-snapshots</id>
			<name>Central Snapshots</name>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<properties>
		<osgi.scm.repository>osgi/osgi.core</osgi.scm.repository>

		<!-- One version per specification repository. It selects the API
		     artifact org.osgi:<repo> for the jar and, for the book, the
		     DocBook artifact org.osgi.spec:<repo>. The values are the
		     artifacts of OSGi Core Release 8. -->
		<org.osgi.dto.version>1.1.1</org.osgi.dto.version>
		<org.osgi.framework.version>1.10.0</org.osgi.framework.version>
		<org.osgi.resource.version>1.0.1</org.osgi.resource.version>
		<org.osgi.service.condition.version>1.0.0</org.osgi.service.condition.version>
		<org.osgi.service.condpermadmin.version>1.1.2</org.osgi.service.condpermadmin.version>
		<org.osgi.service.log.version>1.5.0</org.osgi.service.log.version>
		<org.osgi.service.packageadmin.version>1.2.1</org.osgi.service.packageadmin.version>
		<org.osgi.service.permissionadmin.version>1.2.1</org.osgi.service.permissionadmin.version>
		<org.osgi.service.resolver.version>1.1.1</org.osgi.service.resolver.version>
		<org.osgi.service.startlevel.version>1.1.1</org.osgi.service.startlevel.version>
		<org.osgi.service.url.version>1.0.1</org.osgi.service.url.version>
		<org.osgi.util.tracker.version>1.5.3</org.osgi.util.tracker.version>
		<!-- javadoc only, included by the Framework API chapter -->
		<org.osgi.annotation.bundle.version>1.1.0</org.osgi.annotation.bundle.version>
		<org.osgi.annotation.versioning.version>1.1.1</org.osgi.annotation.versioning.version>
		<!-- javadoc only, referred to by the Log Service API -->
		<org.osgi.service.log.stream.version>1.0.0</org.osgi.service.log.stream.version>
		<!-- the only dependency of the published osgi.core pom -->
		<osgi.annotation.version>7.0.0</osgi.annotation.version>
	</properties>

	<modules>
		<module>api</module>
		<module>spec</module>
	</modules>

	<build>
		<plugins>
			<!-- Resolve ${revision} before install/deploy. The parent manages this
			     plugin but does not activate it, so every installed pom kept the
			     unresolved property in its parent reference: consuming a module
			     from the repository — or publishing it — then fails. Declared
			     here in the reactor, the modules inherit it. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- the release number for descriptions and titles:
				     ${parsedVersion.majorVersion} -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>parse-version</id>
						<goals>
							<goal>parse-version</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
